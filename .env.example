# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration
# Default to SQLite for zero-config local testing, switch to PostgreSQL + TimescaleDB for production
DATABASE_URL=sqlite+aiosqlite:///./crypto_intelligence.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crypto_intel
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache Configuration
# Set REDIS_URL to redis://localhost:6379/0 for production Redis, or leave empty/unreachable for in-memory fallback
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# API & Service Ports
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Exchange & Ingestion Settings
DEFAULT_TIMEFRAME=1h
SUPPORTED_TIMEFRAMES=5m,15m,1h,4h,1d
PUBLIC_EXCHANGES=binance,coinbase,kraken
RATE_LIMIT_CALLS_PER_MINUTE=60

# Paper Trading & Risk Management
PAPER_INITIAL_CAPITAL=100000.0
MAKER_FEE_BPS=2.0
TAKER_FEE_BPS=5.0
DEFAULT_SLIPPAGE_BPS=5.0
MAX_PORTFOLIO_EXPOSURE_PCT=80.0
MAX_SINGLE_POSITION_PCT=15.0
MAX_MEME_EXPOSURE_PCT=5.0
MAX_DRAWDOWN_LIMIT_PCT=15.0

# Alerting
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false

# ==============================================================================
# Crypto Intelligence Platform v2.0 -> v3.0 — Environment Configuration
# ==============================================================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# -- Application ---------------------------------------------------------------
APP_NAME="Crypto Intelligence Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# -- Data Mode -----------------------------------------------------------------
# Controls which data source is active. Must be set explicitly.
# LIVE        - real exchange market feeds (requires working CCXT / internet)
# HISTORICAL  - database-backed historical data only
# SYNTHETIC_TEST - deterministic test data (dashboard shows WARNING banner)
# REPLAY      - historic playback mode
DATA_MODE=LIVE

# -- Feature Flags -------------------------------------------------------------
MARKET_DATA_ENABLED=true
PAPER_TRADING_ENABLED=true
# v2.0/v3.0 INVARIANT: Live trading is permanently disabled.
# Do NOT set this to true. It will raise a startup validation error.
LIVE_TRADING_ENABLED=false

# -- Database ------------------------------------------------------------------
# Default: SQLite (zero-config, good for development)
DATABASE_URL=sqlite+aiosqlite:///./crypto_intelligence.db
# Production: PostgreSQL / TimescaleDB
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crypto_intelligence

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -- Redis ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TICKER_TTL_SECONDS=30
REDIS_SCANNER_TTL_SECONDS=60
CACHE_TTL_SECONDS=300

# -- CORS (Security) -----------------------------------------------------------
# Production: replace with your actual dashboard domain
# Comma-separated list. Do NOT use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501

# -- API & Dashboard -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# -- Market Data Ingestion -----------------------------------------------------
DEFAULT_EXCHANGE=binance
DEFAULT_TIMEFRAME=1h
SUPPORTED_TIMEFRAMES=5m,15m,1h,4h,1d
PUBLIC_EXCHANGES=binance,coinbase,kraken
RATE_LIMIT_CALLS_PER_MINUTE=60
# How old can a candle be before considered STALE? (seconds)
MARKET_DATA_STALE_THRESHOLD_SECONDS=60
SCANNER_STALE_THRESHOLD_SECONDS=120
# How old can the latest price be before order placement is rejected? (seconds)
PRICE_STALE_THRESHOLD_SECONDS=300

# -- Paper Trading -------------------------------------------------------------
PAPER_INITIAL_CAPITAL=100000.0
MAKER_FEE_BPS=2.0
TAKER_FEE_BPS=5.0
DEFAULT_SLIPPAGE_BPS=5.0
LATENCY_MS=50

# -- Risk Limits ---------------------------------------------------------------
MAX_PORTFOLIO_EXPOSURE_PCT=80.0
MAX_SINGLE_POSITION_PCT=15.0
MAX_MEME_EXPOSURE_PCT=5.0
MAX_SECTOR_EXPOSURE_PCT=30.0
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_LIMIT_PCT=15.0
MAX_OPEN_POSITIONS=12

# -- Dynamic Universe ----------------------------------------------------------
UNIVERSE_MIN_VOLUME_24H_USD=1000000.0
UNIVERSE_MIN_LIQUIDITY_USD=500000.0
UNIVERSE_MAX_ASSETS=200

# -- Alerts --------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false

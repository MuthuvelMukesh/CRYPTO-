# ==============================================================================
# Caddy Reverse Proxy Configuration — Platform v3.0
# Automatic TLS/HTTPS, security headers, and intelligent service routing
# ==============================================================================

{
    admin off
    auto_https off
}

:80 {
    encode gzip zstd

    # Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # API, Health, Streaming, and Documentation routes -> FastAPI Backend
    @api_paths {
        path /api/* /health* /live /ready /system /metrics /openapi.json /docs* /redoc* /stream/*
    }
    handle @api_paths {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Frontend Dashboard routes -> Streamlit / Next.js
    handle {
        reverse_proxy dashboard:8501 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
            # WebSocket support for interactive dashboards
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }
}
